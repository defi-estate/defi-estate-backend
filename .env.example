PORT=3001
# Leave DATABASE_URL unset to run against the in-memory repository (handy for UI work).
DATABASE_URL=postgres://defi_estate:defi_estate@localhost:5432/defi_estate
# Optional. Leave REDIS_URL unset to disable caching entirely (reads go straight to the repository).
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000
STELLAR_NETWORK=testnet
# Soroban RPC endpoint used to simulate and submit contract invocations.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Secret key of the admin account that signs mint and distribution transactions. Never commit it.
STELLAR_ADMIN_SECRET=
# Secret used to sign and verify auth JWTs. Use a long random string and never commit it.
JWT_SECRET=
# Public key of the first operator account, seeded by the operator seed script.
OPERATOR_PUBLIC_KEY=
# Maximum number of requests per IP per minute (in-memory rate limiter). /health is exempt.
RATE_LIMIT_PER_MINUTE=60
# S3-compatible storage for property image uploads. Uploads are disabled when unset.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How often the contract event indexer polls Soroban RPC for new events, in milliseconds.
INDEXER_POLL_INTERVAL_MS=15000
# Email provider used for investor notifications: "resend" or "smtp". Leave unset to disable sending.
EMAIL_PROVIDER=
# API key for the email provider (Resend API key, or SMTP password). Never commit it.
EMAIL_PROVIDER_KEY=
# From address used on notification emails.
EMAIL_FROM=notifications@defi-estate.example
